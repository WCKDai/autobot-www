{
  "version": 5,
  "name": "WCKD",
  "about": "One lab, one system. Each brand is a lowercase letter in pixels and one vivid color; the color is for marks, never for text.",
  "neutrals": {
    "page": "#FFFFFF",
    "paper": "#EFEAE2",
    "wash": "#F6F5F2",
    "rule": "#E4E1DB",
    "muted": "#6E6A64",
    "ink": "#111111",
    "inkPanel": "#1C1B19",
    "inkRule": "#2F2D2A",
    "ash": "#8E8A84",
    "bone": "#EFEAE2",
    "ruleStrong": "#D3D0C9"
  },
  "states": {
    "ok": "#8E8A84",
    "warn": "#E2C044",
    "error": "#FF6A47",
    "errorOnPaper": "#B3250D"
  },
  "type": {
    "web": "JetBrains Mono for everything on the web: reading, headings, labels, code",
    "apps": "the platform's sans for reading in apps; JetBrains Mono for machine text and labels",
    "rules": "Lowercase headlines that end in the brand's pixel square. Sentence case elsewhere. No uppercase labels."
  },
  "web": {
    "pageWidth": "1120px",
    "measure": "68ch",
    "gutter": "clamp(22px, 4vw, 48px)",
    "sectionSpace": "clamp(36px, 6vw, 72px)",
    "headline": "clamp(32px, 5vw, 60px)",
    "principle": "Quiet structure, readable evidence. One pixel mark, one restrained accent; no gradients, glows or decorative cards."
  },
